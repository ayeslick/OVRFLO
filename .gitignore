/test-results/
tools/ponder/test-results/
# Next regenerates this on `next dev`/`next build` (path flips between
# `.next/types` and `.next/dev/types` under Turbopack) — keep local only.
web/next-env.d.ts

# Secrets. The root `.env` entry alone left real gaps: sibling variants
# (.env.local, .env.production) and any .env at depth (tools/ponder/.env,
# script/.env) were NOT covered — only web/ had a wildcard. Secrets belong
# outside the repo entirely (see docs/agents/testing.md), but these patterns
# make an accidental `git add` fail closed rather than depending on that.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.p12
*.keystore
mnemonic.txt

# Local tool/agent config, including anything mirroring ~/.config here.
.config/
.github/*
.DS_Store
.vscode
.agents/*
web/node_modules/
web/.next/
web/out/
web/build/
web/.env*
!web/.env.example
web/*.tsbuildinfo
web/.pem
web/.vercel
web/.postcss-cache/
web/reviews/
tools/ponder/.ponder/
tools/ponder/generated/
node_modules/
.gas-snapshot

