{
  "name": "ovrflo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "typegen": "wagmi generate",
    "build": "node scripts/run-immutable-build.mjs",
    "build:csp": "node scripts/build-csp.mjs",
    "package:vercel": "node scripts/package-vercel-output.mjs && node scripts/verify-vercel-output.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "lint:banned-patterns": "bash scripts/check-banned-patterns.sh",
    "lint:deps": "node scripts/check-wagmi-dedupe.mjs",
    "lint:maps-presence": "cd .. && bash tools/scripts/check-maps-presence.sh",
    "lint:state-index": "cd .. && node tools/scripts/generate-state-function-index.mjs --check",
    "lint:maps": "npm run lint:maps-presence && npm run lint:state-index",
    "lint:security": "npm run lint && npm run lint:banned-patterns",
    "pretest": "npm run typegen && bash scripts/check-banned-patterns.sh && npm run lint:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run pretest && bddgen && playwright test",
    "test:e2e:ui": "npm run pretest && bddgen && playwright test --ui",
    "a11y": "bash scripts/a11y-sweep.sh",
    "anvil:fork": "anvil --fork-url \"$MAINNET_RPC_URL\" --chain-id 1",
    "deploy:seed:local": "cd .. && ./script/seed-local.sh",
    "deploy:seed:devnet": "cd .. && forge script script/SeedDevnet.s.sol:SeedDevnet --rpc-url \"$TENDERLY_RPC_URL\" --broadcast --slow && DEPLOYMENT_RPC_URL=\"$TENDERLY_RPC_URL\" node tools/scripts/write-deployment-artifact.mjs deployments/devnet.json",
    "env:write:local": "cd .. && ./tools/scripts/write-env.sh local",
    "env:write:devnet": "cd .. && ./tools/scripts/write-env.sh devnet",
    "ui:dev": "next dev --turbopack",
    "bootstrap:local": "cd .. && ./tools/scripts/bootstrap-local.sh",
    "bootstrap:local:clean": "cd .. && ./tools/scripts/bootstrap-clean.sh local",
    "bootstrap:devnet": "cd .. && ./tools/scripts/bootstrap-devnet.sh",
    "bootstrap:devnet:clean": "cd .. && ./tools/scripts/bootstrap-clean.sh devnet",
    "bootstrap:e2e": "cd .. && ./tools/scripts/bootstrap-e2e.sh"
  },
  "dependencies": {
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@tanstack/query-core": "5.90.12",
    "@tanstack/react-query": "5.90.12",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.55.5",
    "wagmi": "3.7.3"
  },
  "overrides": {
    "@wagmi/core": "3.6.3",
    "@wagmi/connectors": "8.0.24"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.2",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@wagmi/cli": "2.10.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^28.1.0",
    "playwright-bdd": "^9.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
